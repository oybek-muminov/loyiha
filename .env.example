# ---------------------------------------------------------------------------
# UniverAcademy — muhit o'zgaruvchilari namunasi
# Nusxalang: cp .env.example .env  (va qiymatlarni to'ldiring)
# ---------------------------------------------------------------------------

# --- Umumiy ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# --- PostgreSQL ---
POSTGRES_USER=univer
POSTGRES_PASSWORD=univer
POSTGRES_DB=univeracademy
DATABASE_URL=postgresql://univer:univer@localhost:5432/univeracademy?connect_timeout=5

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me-please-32chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MINIAPP_URL=http://localhost:3000/tg
TELEGRAM_BOT_POLLING=false

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=univeracademy-media
R2_PUBLIC_BASE=https://media.univeracademy.uz
R2_UPLOAD_PREFIX=uploads

# --- Media ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=2147483648

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Admin ---
CORS_ORIGINS=http://localhost:3000
ADMIN_TELEGRAM_IDS=
